{
  "name": "json-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "vite",
    "predev:electron": "pnpm electron:build",
    "dev:electron": "run-p electron:vite electron:dev",
    "electron:vite": "vite --host 127.0.0.1",
    "electron:build": "vite build --config vite.electron.config.ts",
    "electron:dev": "wait-on http-get://127.0.0.1:5173 file:electron-dist/main.cjs && electron . --dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:electron": "run-p type-check \"build-only --mode electron\" electron:build -- && electron-builder",
    "package:electron": "run-p type-check \"build-only --mode electron\" electron:build -- && electron-builder --dir",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "tsc -b",
    "lint": "oxlint . --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "json5": "2.2.3",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.74.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "build": {
    "appId": "com.jsontools.app",
    "productName": "JSON Tools",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
